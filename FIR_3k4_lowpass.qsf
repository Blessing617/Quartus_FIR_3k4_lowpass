set_location_assignment PIN_T4 -to adc_value[2]
set_location_assignment PIN_R5 -to adc_value[1]
set_location_assignment PIN_T5 -to adc_value[0]
set_location_assignment PIN_E1 -to clk_50M
set_location_assignment PIN_T13 -to dac_clk
set_location_assignment PIN_R12 -to dac_value[7]
set_location_assignment PIN_T12 -to dac_value[6]
set_location_assignment PIN_R11 -to dac_value[5]
set_location_assignment PIN_T11 -to dac_value[4]
set_location_assignment PIN_R10 -to dac_value[3]
set_location_assignment PIN_T10 -to dac_value[2]
set_location_assignment PIN_R9 -to dac_value[1]
set_location_assignment PIN_T9 -to dac_value[0]
set_location_assignment PIN_N13 -to rst_n
set_global_assignment -name QIP_FILE PLL_1M.qip
